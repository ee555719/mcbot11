<Window x:Class="McBot11.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:McBot11.App"
        mc:Ignorable="d"
        Title="McBot11 - Minecraft ↔ QQ 消息桥接" Height="780" Width="1240"
        Background="#FF1E1E1E" Foreground="#FFDDDDDD" FontSize="12.5"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#FFDDDDDD"/>
            <Setter Property="BorderBrush" Value="#FF4A4A4A"/>
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#FFCCCCCC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,2"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF2D2D30"/>
            <Setter Property="Foreground" Value="#FFEEEEEE"/>
            <Setter Property="BorderBrush" Value="#FF4A4A4A"/>
            <Setter Property="CaretBrush" Value="#FFFFFFFF"/>
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FFFFFFFF"/>
            <Setter Property="Foreground" Value="#FF000000"/>
            <Setter Property="BorderBrush" Value="#FF4A4A4A"/>
            <Setter Property="Padding" Value="3,2"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#FFFFFFFF"/>
            <Setter Property="Foreground" Value="#FF000000"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF3E3E42"/>
            <Setter Property="Foreground" Value="#FFEEEEEE"/>
            <Setter Property="BorderBrush" Value="#FF5A5A5A"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="4,2"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFDDDDDD"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="540"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 左：配置区 ============ -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Background="#FF252526">
            <StackPanel>

                <GroupBox Header="Minecraft 服务器">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="55"/><ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                <RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="地址"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Margin="4,2" Text="{Binding McHost, UpdateSourceTrigger=PropertyChanged}"/>
                            <Label Grid.Row="0" Grid.Column="2" Content="端口"/>
                            <TextBox Grid.Row="0" Grid.Column="3" Margin="4,2" Text="{Binding McPort, UpdateSourceTrigger=PropertyChanged}"/>

                            <Label Grid.Row="1" Grid.Column="0" Content="假人名字"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="4,2" Text="{Binding McUsername, UpdateSourceTrigger=PropertyChanged}"/>
                            <Label Grid.Row="1" Grid.Column="2" Content="协议"/>
                            <ComboBox Grid.Row="1" Grid.Column="3" Margin="4,2"
                                      ItemsSource="{Binding ProtocolOptions}"
                                      SelectedItem="{Binding SelectedProtocol}"
                                      DisplayMemberPath="Label"/>

                            <Label Grid.Row="2" Grid.Column="0" Content="登录方式"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" Margin="4,2"
                                      ItemsSource="{Binding AuthTypes}"
                                      SelectedItem="{Binding McAuthType}"/>
                            <Label Grid.Row="2" Grid.Column="2" Content="状态"/>
                            <TextBox Grid.Row="2" Grid.Column="3" Margin="4,2" IsReadOnly="True"
                                     Text="{Binding McStatus, Mode=OneWay}"/>
                        </Grid>

                        <!-- offline -->
                        <Grid Visibility="{Binding ShowOffline, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="登录名"/>
                            <TextBox Grid.Column="1" Margin="4,2"
                                     Text="{Binding OfflineUsername, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <!-- mojang -->
                        <Grid Visibility="{Binding ShowMojang, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <Label Grid.Row="0" Content="邮箱"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Margin="4,2"
                                     Text="{Binding MojangEmail, UpdateSourceTrigger=PropertyChanged}"/>
                                <Label Grid.Row="1" Content="密码"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="4,2"
                                     Text="{Binding MojangPassword, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <!-- yggdrasil -->
                        <StackPanel Visibility="{Binding ShowYggdrasil, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Content="登录账号"/>
                                <ComboBox Grid.Column="1" Margin="4,2"
                                          ItemsSource="{Binding Accounts}"
                                          SelectedItem="{Binding SelectedAccount}"
                                          DisplayMemberPath="Label"
                                          ToolTip="第三方账号池（config\accounts.json）；连接 MC 时按此账号登录"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                <Button Content="添加账号" Command="{Binding AddAccountCommand}"/>
                                <Button Content="编辑账号" Command="{Binding EditAccountCommand}"/>
                                <Button Content="删除账号" Command="{Binding DeleteAccountCommand}"/>
                                <Button Content="测试账号" Command="{Binding TestAccountCommand}"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Label Content="登录角色"/>
                                <ComboBox Grid.Column="1" Margin="4,2"
                                          ItemsSource="{Binding Roles}"
                                          SelectedItem="{Binding SelectedRole}"
                                          DisplayMemberPath="Name"
                                          ToolTip="当前账号的 availableProfiles 角色列表；选择后写入 accounts.json 的 selectedProfileId"/>
                                <Button Grid.Column="2" Content="获取角色" Command="{Binding FetchRolesCommand}"
                                        ToolTip="拉取/刷新角色列表（缓存 1 小时内直接读取）"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Content="根地址"/>
                                <TextBox Grid.Column="1" Margin="4,2"
                                         Text="{Binding YggRoot, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <Label Grid.Row="0" Content="邮箱"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Margin="4,2"
                                         Text="{Binding YggEmail, UpdateSourceTrigger=PropertyChanged}"/>
                                <Label Grid.Row="1" Content="密码"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="4,2"
                                         Text="{Binding YggPassword, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </StackPanel>

                        <!-- microsoft -->
                        <TextBlock Visibility="{Binding ShowMicrosoft, Converter={StaticResource BoolToVis}}"
                                   Margin="4,4,4,0" Foreground="#FF888888" TextWrapping="Wrap"
                                   Text="Microsoft：无密码字段；点击【测试认证】后按提示打开 microsoft.com/link 输入设备码。refresh token 缓存于 config\tokens.json。"/>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" Content="断线自动重连"
                                      IsChecked="{Binding AutoReconnect}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Label Content="间隔(秒)"/>
                                <TextBox Width="46" Text="{Binding ReconnectInterval, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="测试认证" Command="{Binding TestAuthCommand}"/>
                            <Button Content="连接 MC" Command="{Binding ConnectMcCommand}"/>
                            <Button Content="断开 MC" Command="{Binding DisconnectMcCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- ============ OneBot ============ -->
                <GroupBox Header="OneBot 11 (正向 WebSocket)">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="55"/><ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="WS 地址"/>
                            <TextBox Grid.Column="1" Margin="4,2"
                                     Text="{Binding WsUrl, UpdateSourceTrigger=PropertyChanged}"/>
                            <Label Grid.Column="2" Content="状态"/>
                            <TextBox Grid.Column="3" Margin="4,2" IsReadOnly="True"
                                     Text="{Binding OneBotStatus, Mode=OneWay}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Token"/>
                            <TextBox Grid.Column="1" Margin="4,2"
                                     Text="{Binding AccessToken, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="启动 OneBot" Command="{Binding StartOneBotCommand}"/>
                            <Button Content="停止 OneBot" Command="{Binding StopOneBotCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- ============ 路由 ============ -->
                <GroupBox Header="消息路由">
                    <StackPanel>
                        <CheckBox Content="MC → QQ 转发" IsChecked="{Binding McToQqEnabled}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="目标群号"/>
                            <TextBox Grid.Column="1" Margin="4,2" ToolTip="多个群号用逗号分隔"
                                     Text="{Binding TargetGroups, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="目标私聊"/>
                            <TextBox Grid.Column="1" Margin="4,2" ToolTip="多个 QQ 号用逗号分隔"
                                     Text="{Binding TargetPrivate, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <CheckBox Content="包含假人自身发出的消息"
                                  IsChecked="{Binding IncludeBotSelfMessage}"/>

                        <Separator Margin="0,6"/>
                        <CheckBox Content="QQ → MC 转发" IsChecked="{Binding QqToMcEnabled}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="允许群号"/>
                            <TextBox Grid.Column="1" Margin="4,2" ToolTip="仅这些群可触发；逗号分隔"
                                     Text="{Binding AllowGroups, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="允许私聊"/>
                            <TextBox Grid.Column="1" Margin="4,2" ToolTip="仅这些 QQ 私聊可触发；逗号分隔"
                                     Text="{Binding AllowPrivate, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <CheckBox Content="群消息需 @ 机器人才转发"
                                  IsChecked="{Binding RequireAtInGroup}"/>
                        <TextBlock Margin="4,4,4,0" Foreground="#FF888888" TextWrapping="Wrap"
                                   Text="格式：@机器人 游戏名字 消息 → MC 显示 &lt;假人&gt; (QQ名字) (游戏名字) 消息；私聊：游戏名字 消息。"/>
                    </StackPanel>
                </GroupBox>

                <!-- ============ 模板 ============ -->
                <GroupBox Header="消息格式模板">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="QQ→MC"/>
                            <TextBox Grid.Column="1" Margin="4,2"
                                     Text="{Binding QqToMcTemplate, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="MC→QQ"/>
                            <TextBox Grid.Column="1" Margin="4,2"
                                     Text="{Binding McToQqTemplate, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="系统消息"/>
                            <TextBox Grid.Column="1" Margin="4,2"
                                     Text="{Binding SystemMessageTemplate, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <TextBlock Margin="4,2,4,0" Foreground="#FF888888" TextWrapping="Wrap"
                                   Text="变量：QQ→MC {botName}/{qqName}/{gameName}/{message}；MC→QQ {mcName}/{message}；系统消息 {message}（翻译键已本地化）。"/>
                    </StackPanel>
                </GroupBox>

                <!-- ============ 命令执行 ============ -->
                <GroupBox Header="命令执行（进服自动 + QQ 远程）">
                    <StackPanel>
                        <CheckBox Content="启用自定义命令文件" IsChecked="{Binding CustomCommandsEnabled}"/>
                        <CheckBox Content="假人进服后自动执行（延迟 2.5 秒，顺序执行）"
                                  IsChecked="{Binding ExecuteOnJoin}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/><ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="命令文件"/>
                            <TextBox Grid.Column="1" Margin="4,2"
                                     Text="{Binding CommandsFilePath, UpdateSourceTrigger=PropertyChanged}"/>
                            <Label Grid.Column="2" Content="间隔(ms)"/>
                            <TextBox Grid.Column="3" Margin="4,2"
                                     Text="{Binding CommandInterval, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <Separator Margin="0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="可执行命令群"/>
                            <TextBox Grid.Column="1" Margin="4,2" ToolTip="allowCommandGroups：仅这些群可远程执行 MC 命令；逗号分隔，默认空=无人可执行"
                                     Text="{Binding AllowCommandGroups, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="可执行命令私聊"/>
                            <TextBox Grid.Column="1" Margin="4,2" ToolTip="allowCommandPrivate：仅这些 QQ 可远程执行 MC 命令；逗号分隔，默认空=无人可执行"
                                     Text="{Binding AllowCommandPrivate, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="执行成功后回复" IsChecked="{Binding ReplyOnExecute}" Margin="0,3,12,3"/>
                            <CheckBox Content="失败/无权限时回复" IsChecked="{Binding ReplyOnFailure}"/>
                        </StackPanel>
                        <TextBlock Margin="4,2,4,0" Foreground="#FF888888" TextWrapping="Wrap"
                                   Text="群：@机器人 /say hello；私聊：/say hello。权限白名单默认为空（任何人无法执行），需手动配置。"/>
                    </StackPanel>
                </GroupBox>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,10">
                    <Button Content="保存配置" Command="{Binding SaveConfigCommand}" FontWeight="Bold"/>
                    <Button Content="保存并重启桥接" Command="{Binding RestartBridgeCommand}"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- ============ 右：状态 + 日志 ============ -->
        <Grid Grid.Column="1" Margin="6,4,6,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#FF2D2D30" BorderBrush="#FF4A4A4A" BorderThickness="1"
                    Padding="8,5" Margin="0,0,0,4" CornerRadius="3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="运行状态：" Foreground="#FF888888"/>
                    <TextBlock Text="{Binding McStatus, Mode=OneWay}" Foreground="#FF66CCFF" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding OneBotStatus, Mode=OneWay}" Foreground="#FF66CC66"/>
                    <TextBlock x:Name="BusyIndicator" Text="  处理中…" Foreground="#FFFFCC66"
                               Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Background="#FF1B1B1B" BorderBrush="#FF4A4A4A" BorderThickness="1">
                <ListBox x:Name="LogList"
                         ItemsSource="{Binding Logs}"
                         Background="Transparent" BorderThickness="0"
                         Foreground="#FFCCCCCC" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="4,1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" Foreground="{Binding Color}"
                                       FontFamily="Consolas" TextWrapping="NoWrap"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <DockPanel Grid.Row="2" Margin="0,4,0,0">
                <Button DockPanel.Dock="Right" Content="清空日志" Command="{Binding ClearLogsCommand}"/>
                <ComboBox DockPanel.Dock="Right" Margin="8,0,4,0" Padding="6,2" Width="88"
                          ItemsSource="{Binding LogLevels}"
                          SelectedItem="{Binding LogLevelFilter}"
                          ToolTip="日志显示级别（仅影响界面显示，logs\ 文件始终全量）"/>
                <TextBlock VerticalAlignment="Center" Foreground="#FF777777" Margin="6,0"
                           Text="日志同时写入 D:\mcbot11\logs\（按天切分 mcbot-yyyyMMdd.log）"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
