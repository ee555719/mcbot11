<Window x:Class="McBot11.App.AccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="第三方账号" Width="520" SizeToContent="Height" MinHeight="300"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FF1E1E1E" Foreground="#FFDDDDDD" FontSize="12.5">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#FFCCCCCC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,2"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF2D2D30"/>
            <Setter Property="Foreground" Value="#FFEEEEEE"/>
            <Setter Property="BorderBrush" Value="#FF4A4A4A"/>
            <Setter Property="CaretBrush" Value="#FFFFFFFF"/>
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#FF2D2D30"/>
            <Setter Property="Foreground" Value="#FFEEEEEE"/>
            <Setter Property="BorderBrush" Value="#FF4A4A4A"/>
            <Setter Property="CaretBrush" Value="#FFFFFFFF"/>
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#FF252526"/>
            <Setter Property="Foreground" Value="#FFEEEEEE"/>
            <Setter Property="BorderBrush" Value="#FF4A4A4A"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF3E3E42"/>
            <Setter Property="Foreground" Value="#FFEEEEEE"/>
            <Setter Property="BorderBrush" Value="#FF5A5A5A"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="4,2"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="认证服务器根地址"/>
            <TextBox Grid.Column="1" x:Name="RootBox" Margin="4,2"
                     Text="{Binding ServerRoot, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="邮箱 / 用户名"/>
            <TextBox Grid.Column="1" x:Name="EmailBox" Margin="4,2"
                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="密码"/>
            <PasswordBox Grid.Column="1" x:Name="PwdBox" Margin="4,2"
                         PasswordChanged="OnPwdChanged"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="展示名称"/>
            <TextBox Grid.Column="1" Margin="4,2"
                     Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>

        <CheckBox Grid.Row="4" x:Name="SavePasswordBox" Margin="104,6,0,0"
                  Foreground="#FFDDDDDD" IsChecked="{Binding SavePassword}"
                  Content="保存密码（DPAPI 加密；不勾选则登录时需手动输入）"/>

        <Grid Grid.Row="5" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="FetchRolesButton" Content="获取角色列表" Click="OnFetchRoles"/>
            </StackPanel>
            <TextBlock Grid.Column="1" x:Name="SelectedRoleText" VerticalAlignment="Center"
                       Foreground="#FF66CCFF" TextWrapping="Wrap" Margin="8,0,0,0"
                       Text="（未选择角色）"/>
        </Grid>

        <ListBox Grid.Row="6" x:Name="RoleList" Margin="104,4,0,0" Height="112"
                 SelectionChanged="OnRoleSelected"
                 ToolTip="availableProfiles 角色列表；点击选择登录时使用的角色"/>

        <TextBlock Grid.Row="7" x:Name="ErrorText" Margin="104,8,0,0"
                   Foreground="#FFFF6666" TextWrapping="Wrap" Visibility="Visible"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OkButton" Content="验证并保存" Width="110" Click="OnOk"/>
            <Button Content="取消" Width="80" Click="OnCancel"/>
        </StackPanel>
    </Grid>
</Window>
